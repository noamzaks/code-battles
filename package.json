{
  "name": "code-battles",
  "version": "1.7.15",
  "description": "A library for building interactive competitive coding battles",
  "repository": "https://github.com/noamzaks/code-battles",
  "homepage": "https://code-battles.readthedocs.org",
  "author": "Noam Zaks <imnoamzaks@gmail.com>",
  "license": "MIT",
  "main": "dist/cjs/index.js",
  "module": "dist/esm/index.js",
  "files": [
    "dist"
  ],
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    },
    "./styles.css": "./dist/esm/styles.css"
  },
  "scripts": {
    "build": "rollup -c",
    "dev": "chokidar --silent \"src/**\" \"pdoc-template/**\" \"code_battles/**\" --initial -c \"rollup -c\""
  },
  "dependencies": {
    "@fortawesome/fontawesome-free": "^7.3.1",
    "prismjs": "^1.30.0",
    "react-countdown": "^2.3.6",
    "react-firebase-hooks": "^5.1.1"
  },
  "peerDependencies": {
    "@mantine/charts": "^9.6.1",
    "@mantine/core": "^9.6.1",
    "@mantine/dates": "^9.6.1",
    "@mantine/dropzone": "^9.6.1",
    "@mantine/hooks": "^9.6.1",
    "@mantine/notifications": "^9.6.1",
    "dayjs": "^1.11.23",
    "firebase": "^12.19.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@pyscript/core": "^0.7.31",
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-typescript": "^12.3.0",
    "@types/prismjs": "^1.26.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "chokidar-cli": "^3.0.0",
    "prettier": "^3.9.8",
    "rollup": "^4.63.4",
    "rollup-plugin-copy": "^3.5.0",
    "rollup-plugin-dts": "^6.5.1",
    "rollup-plugin-import-css": "^4.2.1",
    "rollup-plugin-peer-deps-external": "^2.2.4",
    "tslib": "^2.8.1",
    "typescript": "~6.0.3"
  },
  "prettier": {
    "semi": false,
    "endOfLine": "crlf"
  }
}

